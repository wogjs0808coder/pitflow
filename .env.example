# Copy to .env, then replace both password placeholders. Never commit .env.
DB_USERNAME=pitflow
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
PITFLOW_ADMIN_EMAIL=admin@pitflow.local
PITFLOW_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
PITFLOW_ADMIN_INVITE_CODE=
COOKIE_SECURE=false
# Toss Payments test keys. Keep the secret key backend-only.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
